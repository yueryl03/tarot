# Copy to .env for local runs outside Docker Compose.
# Docker Compose sets these itself; do not commit a real .env.

DATABASE_URL=postgresql+asyncpg://tarot:tarot@localhost:5432/tarot
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO
DB_ECHO=false

# mock | openai_compatible
# The default mock provider does not call a network and does not need a key.
INTERPRETATION_PROVIDER=mock
INTERPRETATION_BASE_URL=
INTERPRETATION_API_KEY=
INTERPRETATION_MODEL=
INTERPRETATION_TIMEOUT_SECONDS=60

# Used only by pytest. Must point at a database whose name contains "test".
# TAROT_TEST_DATABASE_URL=postgresql+asyncpg://tarot:tarot@localhost:5432/tarot_test
